<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MockGPS" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/button_text</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSurface">@color/ui_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceVariant">@color/panel_background</item>
        <item name="colorOutline">@color/divider</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/ui_background</item>
        <item name="android:windowBackground">@color/ui_background</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="Theme.MockGPS.Dialog" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">95%</item>
    </style>
    <style name="Widget.MockGPS.IconButton" parent="">
        <item name="android:layout_width">48dp</item><item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/text_primary</item><item name="android:padding">12dp</item>
        <item name="android:clickable">true</item><item name="android:focusable">true</item>
    </style>
    <style name="Widget.MockGPS.SectionTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item><item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/primary</item>
    </style>
    <style name="Widget.MockGPS.Description" parent="TextAppearance.Material3.BodySmall">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:lineSpacingExtra">3dp</item><item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Widget.MockGPS.Switch" parent="">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item><item name="android:saveEnabled">false</item>
        <item name="android:paddingVertical">8dp</item><item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="Widget.MockGPS.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item><item name="android:gravity">start|center_vertical</item>
    </style>
    <bool name="light_system_bars">true</bool>
</resources>
