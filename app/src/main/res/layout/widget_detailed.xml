<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">
    <LinearLayout
        android:id="@+id/widgetHeader" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_action"
        android:padding="4dp"
        android:contentDescription="@string/widget_open_description">
        <TextView android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/primary"/>
        <TextView android:gravity="center"
            android:id="@+id/widgetStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/widget_preview_status"
            android:textSize="16sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>
    </LinearLayout>
    <TextView android:gravity="center"
        android:id="@+id/widgetMode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
        android:text="@string/widget_mode_preview"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/text_secondary"/>
    <TextView android:gravity="center"
        android:id="@+id/widgetAutomation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
        android:text="@string/widget_manual_approval"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/text_secondary"/>
    <TextView android:gravity="center"
        android:id="@+id/widgetReadiness" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
        android:text="@string/widget_unknown"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/text_secondary"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widgetReduce" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginHorizontal="2dp"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:background="@drawable/widget_action"
            android:text="@string/widget_reduce"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:contentDescription="@string/reduce_five_minutes"
            android:visibility="gone"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
            android:orientation="vertical">
            <TextView android:gravity="center"
                android:id="@+id/widgetDeadlineLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:text="@string/widget_no_deadline"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/text_secondary"/>
            <Chronometer
                android:id="@+id/widgetCountdown" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone"/>
        </LinearLayout>
        <TextView
            android:id="@+id/widgetExtend" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginHorizontal="2dp"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:background="@drawable/widget_action"
            android:text="@string/widget_extend"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:contentDescription="@string/add_five_minutes"
            android:visibility="gone"/>
    </LinearLayout>
    <TextView android:gravity="center"
        android:id="@+id/widgetUpdated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="4dp"
        android:text="@string/widget_preview_updated"
        android:textSize="11sp"
        android:maxLines="2"
        android:textColor="@color/text_secondary"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widgetStop" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginHorizontal="2dp"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:background="@drawable/widget_action"
            android:text="@string/widget_force_real"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="2"/>
        <TextView
            android:id="@+id/widgetTimer" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginHorizontal="2dp"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:background="@drawable/widget_action"
            android:text="@string/widget_timer"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="2"/>
        <TextView
            android:id="@+id/widgetOpen" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginHorizontal="2dp"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:background="@drawable/widget_action"
            android:text="@string/widget_open"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="2"/>
    </LinearLayout>
</LinearLayout>
