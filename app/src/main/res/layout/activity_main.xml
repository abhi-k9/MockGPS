<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/rootContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/ui_background">

        <!-- MAP -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/mapContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageButton
                android:id="@+id/mockLocationButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="14dp"
                android:padding="13dp"
                android:background="@drawable/button_mock_location"
                android:src="@drawable/ic_mock_location"
                android:contentDescription="@string/control_ui_text_1"
                android:elevation="8dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- SCALE BAR -->
            <LinearLayout
                android:id="@+id/scaleContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="12dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="5dp"
                android:background="@drawable/scale_background">

                <TextView
                    android:id="@+id/scaleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/control_ui_text_2"
                    android:textColor="@color/map_overlay_text"
                    android:textSize="11sp" />

                <View
                    android:id="@+id/scaleLine"
                    android:layout_width="72dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="3dp"
                    android:background="@color/map_overlay_text" />

            </LinearLayout>

        </FrameLayout>

        <!-- BOTTOM PANEL -->
        <LinearLayout
            android:id="@+id/bottomPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp"
            android:background="@drawable/bottom_panel">

            <TextView
                android:id="@+id/modeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:text="@string/unknown_status"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    style="?android:attr/buttonBarButtonStyle"
                    android:id="@+id/autoButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mode_auto" />
                <Button
                    style="?android:attr/buttonBarButtonStyle"
                    android:id="@+id/forceRealButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mode_force_real" />
            </LinearLayout>

            <Button
                android:id="@+id/confirmPendingButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/confirm_pending"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingBottom="9dp">

                <TextView
                    android:id="@+id/coordinatesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/control_ui_text_3"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/copyCoordinatesButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:padding="15dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_copy"
                    android:contentDescription="@string/control_ui_text_4" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clipChildren="false">

                <TextView
                    android:id="@+id/menuButton"
                    android:contentDescription="@string/open_settings"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:text="@string/control_ui_text_5"
                    android:textColor="@color/baby_blue"
                    android:textSize="26sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/menu_button" />

                <Button
                    android:id="@+id/toggleButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="@string/control_ui_text_6"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:elevation="8dp"
                    android:background="@drawable/button_start" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- DRAWER -->
    <ScrollView
        android:id="@+id/drawer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/drawer_background"
        android:fillViewport="true"
        android:clipToPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- HEADER -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="@string/control_ui_text_7"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:background="@drawable/drawer_header" />

            <!-- SETTINGS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="22dp"
                android:paddingTop="22dp"
                android:paddingEnd="22dp"
                android:text="@string/control_ui_text_8"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="22dp"
                android:text="@string/reboot_policy"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <!-- BROADCAST COMMANDS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:paddingEnd="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/control_ui_text_9"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/control_ui_text_10"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                </LinearLayout>

                <android.widget.Switch
                    android:id="@+id/broadcastSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <Button
                android:id="@+id/showTokenButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:text="@string/reveal_credential" />

            <Button
                android:id="@+id/revokeTokenButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:text="@string/revoke_credential" />

            <Button
                android:id="@+id/delayButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:text="@string/disconnect_delay" />

            <!-- LOCATION DRIFT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:paddingEnd="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/control_ui_text_11"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/control_ui_text_12"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                </LinearLayout>

                <android.widget.Switch
                    android:id="@+id/driftSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <!-- DIVIDER -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@color/divider" />

            <!-- MAP -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="22dp"
                android:paddingTop="14dp"
                android:paddingEnd="22dp"
                android:text="@string/control_ui_text_13"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="22dp"
                android:paddingTop="8dp"
                android:paddingEnd="22dp"
                android:text="@string/map_privacy"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />

            <!-- DIVIDER -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:background="@color/divider" />

            <!-- MOCKGPS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="22dp"
                android:paddingTop="14dp"
                android:paddingEnd="22dp"
                android:text="@string/control_ui_text_14"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="22dp"
                android:paddingTop="8dp"
                android:paddingEnd="22dp"
                android:text="@string/control_ui_text_15"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />

            <!-- GITHUB -->
            <TextView
                android:id="@+id/githubButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:drawableStart="@drawable/github_ic_small"
                android:drawablePadding="10dp"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/control_ui_text_16"
                android:textColor="@color/baby_blue_dark"
                android:textSize="14sp"
                android:background="@drawable/drawer_link" />

            <!-- WEBSITE -->
            <TextView
                android:id="@+id/websiteButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:drawableStart="@drawable/website_ic_small"
                android:drawablePadding="10dp"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/control_ui_text_17"
                android:textColor="@color/baby_blue_dark"
                android:textSize="14sp"
                android:background="@drawable/drawer_link" />

            <!-- DONATIONS -->
            <TextView
                android:id="@+id/donationsButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:drawableStart="@drawable/donations_ic_small"
                android:drawablePadding="10dp"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/control_ui_text_18"
                android:textColor="@color/baby_blue_dark"
                android:textSize="14sp"
                android:background="@drawable/drawer_link" />

            <!-- VERSION -->
            <TextView
                android:id="@+id/versionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="22dp"
                android:paddingTop="22dp"
                android:paddingEnd="22dp"
                android:text="@string/control_ui_text_19"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>